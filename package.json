{
  "name": "local-control-plane",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "description": "本机控制面：VS Code 扩展、本机 broker、时间线见证、过程日志、MCP 与 DeepSeek Harness 插件。",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "controlplane-mcp": "./dist/mcp/stdio.js",
    "controlplane-witness": "./dist/witness/watch.js",
    "controlplane-broker": "./dist/broker/cli.js",
    "controlplane-journal": "./dist/journal/cli.js",
    "controlplane-init": "./dist/init/cli.js",
    "controlplane-doctor": "./dist/doctor/cli.js",
    "controlplane-helper": "./dist/helper/cli.js"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json && node esbuild.mjs",
    "test": "tsc -p tsconfig.json && node --test --test-reporter spec \"dist/test/**/*.test.js\"",
    "witness": "node dist/witness/watch.js",
    "journal": "node dist/journal/cli.js",
    "init": "node dist/init/cli.js",
    "doctor": "node dist/doctor/cli.js",
    "helper": "node dist/helper/cli.js",
    "smoke": "npm run compile && node scripts/smoke.mjs",
    "package:vsix": "npm run compile && cd extension && npx --yes @vscode/vsce@3.2.1 package --allow-missing-repository --skip-license -o ../local-control-plane-0.1.11.vsix",
    "pack": "node scripts/pack-release.mjs",
    "pack:full": "node scripts/pack-release.mjs --profile full",
    "compose:full": "node scripts/compose-full.mjs",
    "build:mac-helper": "bash mac-helper/scripts/build-app.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.101.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
