{
  "name": "local-control-plane",
  "displayName": "本机控制面",
  "description": "本机控制面：模型只交紧凑意图，broker 在本地执行声明过的命令，回执保持压缩。",
  "version": "0.1.11",
  "publisher": "local-control-plane",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "controlplane",
        "label": "本机控制面"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "controlplane",
          "title": "本机控制面",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "controlplane": [
        {
          "type": "webview",
          "id": "controlplane.timeline",
          "name": "时间线"
        }
      ]
    },
    "commands": [
      {
        "command": "controlplane.refreshTimeline",
        "title": "本机控制面: 刷新时间线",
        "icon": "$(refresh)"
      },
      {
        "command": "controlplane.copyMcpConfig",
        "title": "本机控制面: 复制 MCP 配置"
      },
      {
        "command": "controlplane.showStatus",
        "title": "本机控制面: 显示 broker 状态"
      },
      {
        "command": "controlplane.runDoctor",
        "title": "本机控制面: 运行 doctor 自检"
      },
      {
        "command": "controlplane.openWitness",
        "title": "本机控制面: 打开终端见证"
      },
      {
        "command": "controlplane.exportJournal",
        "title": "本机控制面: 导出编程过程日志"
      },
      {
        "command": "controlplane.initWorkspace",
        "title": "本机控制面: 初始化工作区命令"
      },
      {
        "command": "controlplane.startDemoHelper",
        "title": "本机控制面: 启动演示助手"
      },
      {
        "command": "controlplane.stopDemoHelper",
        "title": "本机控制面: 停止演示助手"
      },
      {
        "command": "controlplane.openAuthHelp",
        "title": "本机控制面: 打开授权设置"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "controlplane.refreshTimeline",
          "when": "view == controlplane.timeline",
          "group": "navigation"
        },
        {
          "command": "controlplane.openWitness",
          "when": "view == controlplane.timeline",
          "group": "navigation"
        },
        {
          "command": "controlplane.exportJournal",
          "when": "view == controlplane.timeline",
          "group": "navigation"
        }
      ]
    }
  }
}
