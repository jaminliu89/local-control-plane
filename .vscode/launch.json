{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行本机控制面扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/dist/**/*.cjs"
      ],
      "preLaunchTask": "compile"
    }
  ]
}
